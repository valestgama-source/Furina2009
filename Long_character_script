	/* Infoboxes */
	--infobox-color: white;
	--infobox-background: #2d3a3d;
	--infobox-outline-color: #888c95;
	--infobox-shadow: #595c62;
	--infobox-title-background: #fe4c40;
	--infobox-title-shadow: #b1352c;
	--infobox-title-color: #ffffff;
	--infobox-group-background: #172225;
	--infobox-group-shadow: black;
	--infobox-value-background: var(--infobox-background);
	--infobox-value-color: white;
	
	/* Template:Navbox */
	--navbox-background: var(--body-light);
	--navbox-border: var(--body-dark);
	--navbox-title-background: var(--body-dark);
	--navbox-footer-background: var(--body-dark);
