.dp-tree-wrapper {
    position: relative;
    display: block;
    width: 100%;
    max-width: 720px;
    background: radial-gradient(ellipse at center, rgba(40, 0, 0, 0.4) 0%, rgba(10, 10, 10, 0.95) 80%);
    border: 2px solid rgba(255, 0, 0, 0.4);
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(255, 0, 0, 0.15), inset 0 0 40px rgba(0, 0, 0, 0.7);
    margin: 1em 0;
    overflow: visible;
}

.dp-tree-canvas {
    position: relative;
    margin: 0 auto;
}

.dp-edge {
    position: absolute;
    height: 2px;
    background: rgba(255, 255, 255, 0.7);
    transform-origin: 0 50%;
    pointer-events: none;
    margin-top: -1px;
}

.dp-node {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: help;
}

.dp-node img,
.dp-node .mw-file-element {
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    image-rendering: pixelated;
}

.dp-node:hover {
    z-index: 100;
}

.dp-tooltip {
    display: none;
    position: absolute;
    bottom: 120%;
    background: rgba(10, 10, 10, 0.97);
    border: 2px solid rgba(255, 0, 0, 0.5);
    border-radius: 6px;
    color: #c0c0c0;
    font-size: 0.8rem;
    line-height: 1.4;
    padding: 0.5rem 0.7rem;
    width: 240px;
    pointer-events: none;
    white-space: normal;
    z-index: 200;
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.85);
}

.dp-tooltip-center {
    left: 50%;
    transform: translateX(-50%);
}

.dp-tooltip-left {
    left: 0;
}

.dp-tooltip-right {
    right: 0;
}

.dp-node:hover .dp-tooltip {
    display: block;
}

.dp-tooltip-id {
    color: #FFD700;
    font-weight: 700;
    font-size: 0.85rem;
    text-align: center;
    margin-bottom: 0.3rem;
    border-bottom: 1px solid rgba(255, 0, 0, 0.3);
    padding-bottom: 0.2rem;
}

.dp-tooltip-effect {
    color: #c0c0c0;
}

@media (max-width: 768px) {
    .dp-tree-wrapper {
          overflow-x: auto;
          overflow-y: visible;
    }

    .dp-tooltip {
          width: 180px;
          font-size: 0.7rem;
    }

}

