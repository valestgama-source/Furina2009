}

/* DAMAGE ROW */
.hcard-damage-row {
    display: flex;
    align-items: center;
    gap: 5px;
    border-bottom: none;
    margin-left: 0;
    padding-bottom: 0;
    margin-top: 0px;
    height: 13px;      
    white-space: nowrap;
}

.hc-d-icon-small { 
