    --color-subtle: var(--subtle-color);
    --color-destructive--visited--active: #ff9f9f;
	
	/* Pixelated rounded corners */
	--corner: polygon(
		0px calc(100% - 16px),
		4px calc(100% - 16px),
		4px calc(100% - 8px),
		8px calc(100% - 8px),
		8px calc(100% - 4px),
		16px calc(100% - 4px),
