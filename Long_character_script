}

a.smw-ask-action-btn.smw-ask-action-btn-lblue:visited {
    background-color: var(--body-mid);
    border-color: var(--body-mid);
    color: var(--ooui-text);
}

a.smw-ask-action-btn.smw-ask-action-btn-lblue:hover {
    background-color: var(--body-mid);
    border-color: var(--body-mid);
    color: var(--ooui-text);
