/*************************/
/*   Template:Timeline   */
/*************************/

ul.timeline {
	--accent-color: var(--runeterra-gold-2);
    --col-gap: 2rem;
    --row-gap: 2rem;
    --line-w: 0.25rem;
    --bgColor: var(--league-wiki-dark);
    --bgColor-dark: var(--league-black);
    display: grid;
    grid-template-columns: var(--line-w) 1fr;
    grid-auto-columns: max-content;
    column-gap: var(--col-gap);
    list-style: none;
    width: min(60rem, 90%);
    margin-inline: auto;
	
}

/* line */
ul.timeline::before {
    content: "";
    grid-column: 1;
    grid-row: 1 / span 20;
    background: rgb(225, 225, 225);
    border-radius: calc(var(--line-w) / 2);
}

ul.timeline > li:not(:last-child) {
    margin-bottom: var(--row-gap);
}

ul.timeline > li {
	position: relative;
    --dateH: 3rem;
    grid-column: 2;
    --inlineP: 1.5rem;
    margin-inline: var(--inlineP);
    background-color: var(--bgColor-dark);
    grid-row: span 2;
    display: grid;
    grid-template-rows: min-content min-content min-content;
    border-width: 0 1px 1px 1px;
    border-style: solid;
    border-color: var(--accent-color);
}

ul.timeline > li .timeline-date {
    height: var(--dateH);
    margin-inline: calc(var(--inlineP) * -1);

    text-align: center;
    background-color: var(--accent-color);

    color: white;
    font-size: 1.25rem;
    font-weight: bold;

    display: grid;
    place-content: center;
    position: relative;

    border-radius: calc(var(--dateH) / 2) 0 0 calc(var(--dateH) / 2);
}

ul.timeline > li .timeline-date::before {
    content: "";
    width: var(--inlineP);
    aspect-ratio: 1;
    background: var(--accent-color);
    background-image: linear-gradient(rgba(0, 0, 0, 0.2) 100%, transparent);
    position: absolute;
    top: 100%;

    clip-path: polygon(0 0, 100% 0, 0 100%);
    right: 0;
}

ul.timeline > li .timeline-date::after {
    content: "";
    position: absolute;
    width: 2rem;
    aspect-ratio: 1;
    border: 0.3rem solid var(--accent-color);
    border-radius: 50%;
    top: 50%;
    background: var(--bgColor);
    transform: translate(50%, -50%);
    right: calc(100% + var(--col-gap) + var(--line-w) / 2);
}

ul.timeline > li .timeline-title {
	position: relative;
    margin-inline: 1.5rem;
    overflow: hidden;
    margin-block-start: 1rem;
    margin-block-end: 1rem;
    font-weight: bold;
}

ul.timeline > li .timeline-description {
	position: relative;
    margin-inline: 1.5rem;
    margin-block-end: 1rem;
}

ul.timeline > li .timeline-link {
    position: absolute;
    top: var(--dateH);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
}

ul.timeline > li img {
    display: block;
	box-sizing: border-box;
	padding: 1rem;
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: center;
    border-radius: 1.5rem;
}

@media (min-width: 50rem) {
    ul.timeline {
        grid-template-columns: 1fr var(--line-w) 1fr;
    }

    ul.timeline::before {
        grid-column: 2;
    }

    ul.timeline > li:nth-child(odd) {
        grid-column: 1;
    }

    ul.timeline > li:nth-child(even) {
        grid-column: 3;
    }

    /* start second card */
    ul.timeline > li:nth-child(2) {
        grid-row: 2/4;
    }

    ul.timeline > li:nth-child(odd) .timeline-date::before {
        clip-path: polygon(0 0, 100% 0, 100% 100%);
        left: 0;
    }

    ul.timeline > li:nth-child(odd) .timeline-date::after {
        transform: translate(-50%, -50%);
        left: calc(100% + var(--col-gap) + var(--line-w) / 2);
    }

    ul.timeline > li:nth-child(odd) .timeline-date {
        border-radius: 0 calc(var(--dateH) / 2) calc(var(--dateH) / 2) 0;
    }
}

