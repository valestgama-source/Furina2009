   -------------------- */
a,
.mw-logevent-actionlink a,
.mw-logevent-tool a,
.mw-diff-tool a,
.mw-pager-tools a,
.mw-checkbox-toggle-controls a {
    color: var(--link-color);
}

a:visited,
a:active,
