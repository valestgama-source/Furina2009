       transform: rotate(292.5deg) scale(0.6);
   }
   87.5% {
       transform: rotate(315deg) scale(0.7);
   }
   93.75% {
       transform: rotate(337.5deg) scale(0.6);
   }
   100% {
       transform: rotate(360deg) scale(0.8);
   }
}

