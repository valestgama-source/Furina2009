/* ========================================================================
   §35 TF-ANIMATE v2 — Motor de animaciones avanzado, estilo Moon Animator.
   Rediseñado para rendimiento (solo transform/opacity donde es posible,
   GPU compositing, contención de layout) y para parametrizar intensidad
   sin multiplicar @keyframes. Combinable con CUALQUIER clase tf-*/wiki-*.

   USO BÁSICO (idéntico a v1 — compatibilidad total):
     class="tf-card tf-animationcustom tf-anim-pop-in"

   PERSONALIZACIÓN TOTAL vía variables (nuevo: --tf-anim-intensity escala
   la amplitud del movimiento sin necesitar otro keyframe):
     style="--tf-anim-name: tf-bounce; --tf-anim-duration: .8s;
            --tf-anim-iteration: infinite; --tf-anim-timing: var(--tf-ease-expo-out);
            --tf-anim-intensity: 1.6;"
   ======================================================================== */

:root {
    /* Motor de animación */
    --tf-anim-name: tf-fade-in;
    --tf-anim-duration: .45s;
    --tf-anim-delay: 0s;
    --tf-anim-timing: var(--ease-out);
    --tf-anim-iteration: 1;
    --tf-anim-direction: normal;
    --tf-anim-fill: both;
    --tf-anim-play: running;
    --tf-anim-intensity: 1;            /* escala la amplitud de movimiento de los keyframes paramétricos */

    /* Motor de transición (hover/focus/estado) */
    --tf-trans-property: transform, opacity;
    --tf-trans-duration: var(--tr-normal);
    --tf-trans-delay: 0s;
    --tf-trans-timing: var(--ease);

    /* Librería de easings con nombre real (valores de referencia Material/iOS/Expo) */
    --tf-ease-standard:    cubic-bezier(.4, 0, .2, 1);
    --tf-ease-decelerate:  cubic-bezier(0, 0, .2, 1);
    --tf-ease-accelerate:  cubic-bezier(.4, 0, 1, 1);
    --tf-ease-sharp:       cubic-bezier(.4, 0, .6, 1);
    --tf-ease-expo-out:    cubic-bezier(.19, 1, .22, 1);
    --tf-ease-back:        cubic-bezier(.34, 1.56, .64, 1);
    --tf-ease-overshoot:   cubic-bezier(.175, .885, .32, 1.275);
    --tf-ease-anticipate:  cubic-bezier(.36, 0, .66, -.56);
    --tf-ease-elastic:     cubic-bezier(.68, -.55, .27, 1.55);

    --tf-stagger-step: .08s;           /* paso del sistema de staggering */
}

/* Motor base — compositing en capa propia, sin recalcular layout del resto
   de la página en cada frame (clave para no sentir "lag" en listas largas) */
.tf-animationcustom {
    animation-name: var(--tf-anim-name) !important;
    animation-duration: var(--tf-anim-duration) !important;
    animation-delay: var(--tf-anim-delay) !important;
    animation-timing-function: var(--tf-anim-timing) !important;
    animation-iteration-count: var(--tf-anim-iteration) !important;
    animation-direction: var(--tf-anim-direction) !important;
    animation-fill-mode: var(--tf-anim-fill) !important;
    animation-play-state: var(--tf-anim-play) !important;
    will-change: transform, opacity !important;
    backface-visibility: hidden !important;
    contain: layout paint !important;
}

.tf-transitioncustom {
    transition-property: var(--tf-trans-property) !important;
    transition-duration: var(--tf-trans-duration) !important;
    transition-delay: var(--tf-trans-delay) !important;
    transition-timing-function: var(--tf-trans-timing) !important;
    will-change: var(--tf-trans-property) !important;
}

/* Fuerza delay 0 sin importar lo que fije un .tf-stagger padre o un inline style */
.tf-no-delay { --tf-anim-delay: 0s !important; --tf-trans-delay: 0s !important; }

/* La animación queda pausada hasta hover/focus */
.tf-anim-onhover { animation-play-state: paused !important; }
.tf-anim-onhover:hover,
.tf-anim-onhover:focus-visible { animation-play-state: running !important; }

/* Atajos de animación — solo fijan --tf-anim-name (y su timing/duración
   ideal). Los paramétricos (marcados) ya responden a --tf-anim-intensity. */
.tf-anim-fade-in     { --tf-anim-name: tf-fade-in; }
.tf-anim-fade-out    { --tf-anim-name: tf-fade-out; }
.tf-anim-slide-up    { --tf-anim-name: tf-slide-up; --tf-anim-timing: var(--tf-ease-decelerate); }
.tf-anim-slide-down  { --tf-anim-name: tf-slide-down; --tf-anim-timing: var(--tf-ease-decelerate); }
.tf-anim-slide-left  { --tf-anim-name: tf-slide-left; --tf-anim-timing: var(--tf-ease-decelerate); }
.tf-anim-slide-right { --tf-anim-name: tf-slide-right; --tf-anim-timing: var(--tf-ease-decelerate); }
.tf-anim-scale-in    { --tf-anim-name: tf-scale-in; }
.tf-anim-scale-out   { --tf-anim-name: tf-scale-out; }
.tf-anim-zoom-in     { --tf-anim-name: tf-zoom-in; --tf-anim-duration: .5s; --tf-anim-timing: var(--tf-ease-expo-out); }
.tf-anim-pop-in      { --tf-anim-name: tf-pop-in; --tf-anim-timing: var(--tf-ease-back); }
.tf-anim-bounce      { --tf-anim-name: tf-bounce; --tf-anim-iteration: infinite; --tf-anim-duration: 1.1s; } /* paramétrico */
.tf-anim-pulse       { --tf-anim-name: tf-pulse; --tf-anim-iteration: infinite; --tf-anim-duration: 1.6s; } /* paramétrico */
.tf-anim-shake       { --tf-anim-name: tf-shake; --tf-anim-duration: .5s; }                                 /* paramétrico */
.tf-anim-wobble      { --tf-anim-name: tf-wobble; --tf-anim-duration: .8s; }                                /* paramétrico */
.tf-anim-rubber      { --tf-anim-name: tf-rubber-band; --tf-anim-duration: .9s; }
.tf-anim-tada        { --tf-anim-name: tf-tada; --tf-anim-duration: .9s; }
.tf-anim-flash       { --tf-anim-name: tf-flash; --tf-anim-iteration: infinite; --tf-anim-duration: 1.5s; }
.tf-anim-heartbeat   { --tf-anim-name: tf-heartbeat; --tf-anim-iteration: infinite; --tf-anim-duration: 1.3s; }
.tf-anim-flip        { --tf-anim-name: tf-flip; --tf-anim-duration: .7s; --tf-anim-timing: var(--tf-ease-standard); }
.tf-anim-rotate-in   { --tf-anim-name: tf-rotate-in; --tf-anim-duration: .6s; --tf-anim-timing: var(--tf-ease-back); }
.tf-anim-swing       { --tf-anim-name: tf-swing; --tf-anim-duration: 1s; }
.tf-anim-float       { --tf-anim-name: tf-float; --tf-anim-iteration: infinite; --tf-anim-direction: alternate; --tf-anim-duration: 2.4s; --tf-anim-timing: ease-in-out; } /* paramétrico */
.tf-anim-glow        { --tf-anim-name: tf-glow-pulse; --tf-anim-iteration: infinite; --tf-anim-direction: alternate; --tf-anim-duration: 1.8s; }
.tf-anim-spin-slow   { --tf-anim-name: tf-spin; --tf-anim-iteration: infinite; --tf-anim-duration: 3s; --tf-anim-timing: linear; }
.tf-anim-blur-in     { --tf-anim-name: tf-blur-in; --tf-anim-duration: .6s; }
.tf-anim-jello       { --tf-anim-name: tf-jello; --tf-anim-duration: .9s; }

/* Duración / easing / repetición / dirección — combinables y sobre
   cualquier tf-anim-* previo (el último en cascada gana, como siempre en CSS) */
.tf-dur-fast   { --tf-anim-duration: .2s;  --tf-trans-duration: .15s; }
.tf-dur-normal { --tf-anim-duration: .45s; --tf-trans-duration: .3s; }
.tf-dur-slow   { --tf-anim-duration: .9s;  --tf-trans-duration: .6s; }
.tf-dur-xslow  { --tf-anim-duration: 1.6s; --tf-trans-duration: 1s; }

.tf-delay-xs { --tf-anim-delay: .1s; }
.tf-delay-sm { --tf-anim-delay: .2s; }
.tf-delay-md { --tf-anim-delay: .4s; }
.tf-delay-lg { --tf-anim-delay: .6s; }

.tf-ease-linear     { --tf-anim-timing: linear; --tf-trans-timing: linear; }
.tf-ease-standard   { --tf-anim-timing: var(--tf-ease-standard); --tf-trans-timing: var(--tf-ease-standard); }
.tf-ease-decelerate { --tf-anim-timing: var(--tf-ease-decelerate); --tf-trans-timing: var(--tf-ease-decelerate); }
.tf-ease-accelerate { --tf-anim-timing: var(--tf-ease-accelerate); --tf-trans-timing: var(--tf-ease-accelerate); }
.tf-ease-sharp      { --tf-anim-timing: var(--tf-ease-sharp); --tf-trans-timing: var(--tf-ease-sharp); }
.tf-ease-expo       { --tf-anim-timing: var(--tf-ease-expo-out); --tf-trans-timing: var(--tf-ease-expo-out); }
.tf-ease-back       { --tf-anim-timing: var(--tf-ease-back); --tf-trans-timing: var(--tf-ease-back); }
.tf-ease-overshoot  { --tf-anim-timing: var(--tf-ease-overshoot); --tf-trans-timing: var(--tf-ease-overshoot); }
.tf-ease-anticipate { --tf-anim-timing: var(--tf-ease-anticipate); --tf-trans-timing: var(--tf-ease-anticipate); }
.tf-ease-elastic    { --tf-anim-timing: var(--tf-ease-elastic); --tf-trans-timing: var(--tf-ease-elastic); }

.tf-loop-2        { --tf-anim-iteration: 2; }
.tf-loop-3        { --tf-anim-iteration: 3; }
.tf-loop-infinite { --tf-anim-iteration: infinite; }

.tf-dir-reverse   { --tf-anim-direction: reverse; }
.tf-dir-alternate { --tf-anim-direction: alternate; }

/* Intensidad — escala la amplitud de los keyframes paramétricos (bounce,
   pulse, shake, wobble, float) SIN definir un @keyframes nuevo por nivel */
.tf-intensity-subtle { --tf-anim-intensity: .5; }
.tf-intensity-normal { --tf-anim-intensity: 1; }
.tf-intensity-strong { --tf-anim-intensity: 1.75; }
.tf-intensity-max    { --tf-anim-intensity: 2.5; }

/* Staggering — delay incremental automático para hijos directos de una
   lista/grid, sin JS. Cada hijo lee --tf-stagger-step * su posición. */
.tf-stagger > :nth-child(1)  { --tf-anim-delay: calc(var(--tf-stagger-step) * 0); }
.tf-stagger > :nth-child(2)  { --tf-anim-delay: calc(var(--tf-stagger-step) * 1); }
.tf-stagger > :nth-child(3)  { --tf-anim-delay: calc(var(--tf-stagger-step) * 2); }
.tf-stagger > :nth-child(4)  { --tf-anim-delay: calc(var(--tf-stagger-step) * 3); }
.tf-stagger > :nth-child(5)  { --tf-anim-delay: calc(var(--tf-stagger-step) * 4); }
.tf-stagger > :nth-child(6)  { --tf-anim-delay: calc(var(--tf-stagger-step) * 5); }
.tf-stagger > :nth-child(7)  { --tf-anim-delay: calc(var(--tf-stagger-step) * 6); }
.tf-stagger > :nth-child(8)  { --tf-anim-delay: calc(var(--tf-stagger-step) * 7); }
.tf-stagger > :nth-child(9)  { --tf-anim-delay: calc(var(--tf-stagger-step) * 8); }
.tf-stagger > :nth-child(10) { --tf-anim-delay: calc(var(--tf-stagger-step) * 9); }
.tf-stagger > :nth-child(n+11) { --tf-anim-delay: calc(var(--tf-stagger-step) * 10); }

/* Librería de keyframes. Los marcados "paramétrico" usan --tf-anim-intensity
   dentro del propio calc(), así que UN solo keyframe cubre todas las
   intensidades — no hay que duplicar @keyframes para "bounce fuerte". */
@keyframes tf-fade-in     { from { opacity: 0; } to { opacity: 1; } }
@keyframes tf-fade-out    { from { opacity: 1; } to { opacity: 0; } }
@keyframes tf-slide-up    { from { opacity: 0; transform: translate3d(0, 18px, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
@keyframes tf-slide-down  { from { opacity: 0; transform: translate3d(0, -18px, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
@keyframes tf-slide-left  { from { opacity: 0; transform: translate3d(18px, 0, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
@keyframes tf-slide-right { from { opacity: 0; transform: translate3d(-18px, 0, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
@keyframes tf-scale-in    { from { opacity: 0; transform: scale3d(.85, .85, 1); } to { opacity: 1; transform: scale3d(1, 1, 1); } }
@keyframes tf-scale-out   { from { opacity: 1; transform: scale3d(1, 1, 1); } to { opacity: 0; transform: scale3d(.85, .85, 1); } }
@keyframes tf-zoom-in     { from { opacity: 0; transform: scale3d(1.3, 1.3, 1); } to { opacity: 1; transform: scale3d(1, 1, 1); } }
@keyframes tf-pop-in      { 0% { opacity: 0; transform: scale3d(.6, .6, 1); } 70% { opacity: 1; transform: scale3d(1.05, 1.05, 1); } 100% { transform: scale3d(1, 1, 1); } }

/* paramétrico: amplitud vertical = 10px * intensidad */
@keyframes tf-bounce {
    0%, 100% { transform: translate3d(0, 0, 0); }
    25%      { transform: translate3d(0, calc(-10px * var(--tf-anim-intensity)), 0); }
    50%      { transform: translate3d(0, 0, 0); }
    75%      { transform: translate3d(0, calc(-5px * var(--tf-anim-intensity)), 0); }
}
/* paramétrico: amplitud de escala = .04 * intensidad */
@keyframes tf-pulse {
    0%, 100% { transform: scale3d(1, 1, 1); }
    50%      { transform: scale3d(calc(1 + .04 * var(--tf-anim-intensity)), calc(1 + .04 * var(--tf-anim-intensity)), 1); }
}
/* paramétrico: amplitud horizontal = 6px * intensidad */
@keyframes tf-shake {
    0%, 100% { transform: translate3d(0, 0, 0); }
    20%      { transform: translate3d(calc(-6px * var(--tf-anim-intensity)), 0, 0); }
    40%      { transform: translate3d(calc(6px * var(--tf-anim-intensity)), 0, 0); }
    60%      { transform: translate3d(calc(-4px * var(--tf-anim-intensity)), 0, 0); }
    80%      { transform: translate3d(calc(4px * var(--tf-anim-intensity)), 0, 0); }
}
/* paramétrico: amplitud de rotación = 3deg * intensidad */
@keyframes tf-wobble {
    0%, 100% { transform: rotate(0deg); }
    25%      { transform: rotate(calc(-3deg * var(--tf-anim-intensity))); }
    75%      { transform: rotate(calc(3deg * var(--tf-anim-intensity))); }
}
@keyframes tf-rubber-band {
    0%   { transform: scale3d(1, 1, 1); }
    30%  { transform: scale3d(1.25, .75, 1); }
    40%  { transform: scale3d(.75, 1.25, 1); }
    60%  { transform: scale3d(1.15, .85, 1); }
    100% { transform: scale3d(1, 1, 1); }
}
@keyframes tf-tada {
    0%                   { transform: scale3d(1, 1, 1) rotate(0); }
    10%, 20%             { transform: scale3d(.9, .9, 1) rotate(-3deg); }
    30%, 50%, 70%, 90%   { transform: scale3d(1.1, 1.1, 1) rotate(3deg); }
    40%, 60%, 80%        { transform: scale3d(1.1, 1.1, 1) rotate(-3deg); }
    100%                 { transform: scale3d(1, 1, 1) rotate(0); }
}
@keyframes tf-flash     { 0%, 50%, 100% { opacity: 1; } 25%, 75% { opacity: .25; } }
@keyframes tf-heartbeat { 0%, 100% { transform: scale3d(1,1,1); } 14% { transform: scale3d(1.1,1.1,1); } 28% { transform: scale3d(1,1,1); } 42% { transform: scale3d(1.1,1.1,1); } 70% { transform: scale3d(1,1,1); } }
@keyframes tf-flip      { from { transform: perspective(600px) rotateY(90deg); opacity: 0; } to { transform: perspective(600px) rotateY(0); opacity: 1; } }
@keyframes tf-rotate-in { from { transform: rotate(-180deg) scale3d(.6,.6,1); opacity: 0; } to { transform: rotate(0) scale3d(1,1,1); opacity: 1; } }
@keyframes tf-swing     { 20% { transform: rotate(10deg); } 40% { transform: rotate(-8deg); } 60% { transform: rotate(5deg); } 80% { transform: rotate(-3deg); } 100% { transform: rotate(0); } }
/* paramétrico: amplitud vertical = 8px * intensidad */
@keyframes tf-float {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(0, calc(-8px * var(--tf-anim-intensity)), 0); }
}
@keyframes tf-glow-pulse { from { box-shadow: 0 0 4px rgba(51,102,204,.15); } to { box-shadow: 0 0 18px rgba(51,102,204,.55); } }
@keyframes tf-spin       { to { transform: rotate(360deg); } }
@keyframes tf-blur-in    { from { filter: blur(8px); opacity: 0; } to { filter: blur(0); opacity: 1; } }
@keyframes tf-jello {
    0%, 100% { transform: skewX(0) skewY(0); }
    22%      { transform: skewX(-6deg) skewY(-3deg); }
    44%      { transform: skewX(4deg) skewY(2deg); }
    66%      { transform: skewX(-2deg) skewY(-1deg); }
    88%      { transform: skewX(1deg) skewY(0); }
}

@media (prefers-reduced-motion: reduce) {
    :is(.tf-animationcustom, .tf-transitioncustom) {
        animation: none !important;
        transition: none !important;
        will-change: auto !important;
    }
}
/* === FIN TF-ANIMATE === */

