/* --- SMITE STYLE FULL-CARD HOVERCARD --- */
#god-hover-card {
    position: absolute;
    z-index: 10000;
    pointer-events: none;
    visibility: hidden;
    /* Increased from 560px to 577px to fit 187px art side */
    width: 577px; 
    
    /* ADJUST TOTAL HEIGHT HERE (Pixels) */
    height: 280px; 
    
    /* Updated border width to 2px for better visibility */
    border: 1px solid #ffc36b;
    box-sizing: border-box; 
    
    background: #010a13;
    box-shadow: 0 0 35px rgba(0,0,0,0.95);
    font-family: sans-serif;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
    display: flex;
}

#god-hover-card.visible { visibility: visible; opacity: 1; }

#god-hover-card.visible { visibility: visible; opacity: 1; }

.hcard-body { display: flex; width: 100%; height: 100%; }

/* PORTRAIT SIDE (Left) */
.hcard-art-side {
    width: 187px; /* Matches the 2:3 ratio of your 280px height */
    height: 100%;
    border-right: 1px solid #c8aa6e;
    flex-shrink: 0;
    background: #010a13; /* Match your card background */
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
}

.hcard-bg {
    width: 100%;
    height: 100%;
    background-size: cover; 
    background-position: center top; 
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
}

/* THE OVERLAY FRAME */
.hcard-frame {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5; 
    pointer-events: none;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-color: transparent !important;
}

.hcard-frame img, .hcard-bg img { display: none !important; }

/* CONTENT SIDE (Right) */
.hcard-text-side {
    flex-grow: 1;
    background: linear-gradient(135deg, #0a141e 0%, #010a13 100%);
    padding: 18px 25px 12px 20px; /* Adjusted padding */
    display: flex;
    flex-direction: column;
    position: relative;
    border-bottom: none;
    margin-left: 0;
}

/* DATA BLOCK (Top Right) */
.hcard-roles-stack {
    position: absolute;
    top: 18px; 
    right: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px; 
}

/* --- UPDATED ROLE CONTAINER LOGIC --- */
.hc-role-container {
    display: flex;
    align-items: center;
    gap: 0px; 
}

.hc-role-item {
    display: flex;
    align-items: center;
    gap: 5px; 
    color: #c8aa6e;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    margin: 0;
    padding: 0;
}

.hc-role-dot {
    margin-left: 5px; 
    margin-right: 5px; 
    color: #5b4a2d;
    font-size: 12px;
    line-height: 1;
}

.hc-role-item::after, .hc-role-container::after {
    content: none !important;
}

.hc-role-icon-small {
    width: 13px;
    height: 13px;
    object-fit: contain;
}

/* DAMAGE ROW */
.hcard-damage-row {
    display: flex;
    align-items: center;
    gap: 5px;
    border-bottom: none;
    margin-left: 0;
    padding-bottom: 0;
    margin-top: 0px;
    height: 13px;      
    white-space: nowrap;
}

.hc-d-icon-small { 
    width: 16px; 
    height: 16px; 
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.hc-dam-text {
    color: #a09b8c;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/** DAMAGE TYPE ICON MAPPING **/
.type-ranged-physical { background-image: url('https://wiki.smite2.com/images/Ranged_Physical.png'); }
.type-ranged-magical  { background-image: url('https://wiki.smite2.com/images/Ranged_Magical.png'); }
.type-melee-physical  { background-image: url('https://wiki.smite2.com/images/Melee_Physical.png'); }
.type-melee-magical   { background-image: url('https://wiki.smite2.com/images/Melee_Magical.png'); }

/* HEADER: Name Group */
.hcard-header {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(200, 170, 110, 0.3);
}

.hcard-name-group { 
    display: flex; 
    flex-direction: column; 
    justify-content: center;
}

.hcard-name {
    color: #f0e6d2;
    font-size: 15px;
    font-weight: bold;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: 1px;
}

.hcard-title {
    color: #cdbe91;
    font-size: 13px;
    margin-top: 4px; 
    font-weight: bold;
    font-style: normal;
    line-height: 1;
}

/* STATS GRID (With Icons) */
.hcard-stats-grid {
    flex-grow: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
    row-gap: 4px;
    padding: 10px 0; /* Tightened padding */
    align-content: center;
}

.hc-stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(200, 170, 110, 0.05);
    padding: 2px 0;
}

.hc-stat-label {
    display: flex;
    align-items: center;
    color: #a09b8c;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.hc-stat-label i {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    display: inline-block;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

/* Color for the (+Per Lvl) stat in hovercards */
.hc-stat-lvl {
    color: #4CAF50; /* A nice green for growth/scaling */
    font-size: 0.85em;
    margin-left: 4px;
    font-weight: normal;
}

/** STAT ICON MAPPING **/
.si-hp    { background-image: url('https://wiki.smite2.com/images/T_StatIcon_Health.png'); }
.si-hpr   { background-image: url('https://wiki.smite2.com/images/T_StatIcon_HealthRegen.png'); }
.si-mp    { background-image: url('https://wiki.smite2.com/images/T_StatIcon_Mana.png'); }
.si-mpr   { background-image: url('https://wiki.smite2.com/images/T_StatIcon_ManaRegen.png'); }
.si-pprot { background-image: url('https://wiki.smite2.com/images/T_StatIcon_PhysicalProt.png'); }
.si-mprot { background-image: url('https://wiki.smite2.com/images/T_StatIcon_MagicalProt.png'); }
.si-as    { background-image: url('https://wiki.smite2.com/images/T_StatIcon_AttackSpeed.png'); }
.si-ap    { background-image: url('https://wiki.smite2.com/images/T_StatIcon_BasicAttackPower.png'); }
.si-ms    { background-image: url('https://wiki.smite2.com/images/T_StatIcon_MovementSpeed.png'); }

.hc-stat-val {
    color: #f0e6d2;
    font-size: 11px;
    font-weight: bold;
    font-family: 'Segoe UI', sans-serif;
}

/* ABILITIES - CENTERED AT BOTTOM */
.hcard-abilities {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: auto; /* Pushes icons to the very bottom of the text side */
    padding-bottom: 5px; /* Tiny buffer from the edge */
    width: 100%;
}

.hc-ability-icon {
    width: 44px;
    height: 44px;
    background-size: cover;
    border: 1px solid #c8aa6e;
    flex-shrink: 0;
}

/* CLEANUP & FIXES */
#god-hover-card hr, 
.hcard-fader,
.hc-p-icon-header { 
    display: none !important; 
}

/* ==========================================================================
   HIGH-SPECIFICITY TOC NUMBERING FOR GLOBAL COMMON.CSS
   ========================================================================== */

/* Target elements explicitly under the body tag to increase cascading power */
body .toc, body .mw-toc, body #toc, body .sidebar-toc {
    counter-reset: toc-level-1 !important;
}

body .toc ul, body .toc ol, 
body .mw-toc ul, body .mw-toc ol, 
body .sidebar-toc-list ul, body .sidebar-toc-list ol {
    counter-reset: toc-level-2 !important;
}

body .toc ul ul, body .toc ol ol, 
body .mw-toc ul ul, body .mw-toc ol ol, 
body .sidebar-toc-list ul ul, body .sidebar-toc-list ol ol {
    counter-reset: toc-level-3 !important;
}

body .toc li, body .mw-toc li, body .sidebar-toc-item {
    list-style: none !important; 
}

/* Level 1: "1. " */
body .toc > ul > li > a::before, 
body .mw-toc > ul > li > a::before,
body .sidebar-toc-list > li > .sidebar-toc-link::before {
    counter-increment: toc-level-1 !important;
    content: counter(toc-level-1) ". " !important;
    font-weight: bold !important;
    margin-right: 0.5em !important;
}

/* Level 2: "1.1. " */
body .toc > ul > li > ul > li > a::before, 
body .mw-toc > ul > li > ul > li > a::before,
body .sidebar-toc-list > li > ul > li > .sidebar-toc-link::before {
    counter-increment: toc-level-2 !important;
    content: counter(toc-level-1) "." counter(toc-level-2) ". " !important;
    margin-right: 0.5em !important;
}

/* Level 3: "1.1.1. " */
body .toc > ul > li > ul > li > ul > li > a::before, 
body .mw-toc > ul > li > ul > li > ul > li > a::before,
body .sidebar-toc-list > li > ul > li > ul > li > .sidebar-toc-link::before {
    counter-increment: toc-level-3 !important;
    content: counter(toc-level-1) "." counter(toc-level-2) "." counter(toc-level-3) ". " !important;
    margin-right: 0.5em !important;
}

.img-tab-nav {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
    align-items: center;
}

.img-trigger {
    cursor: pointer;
    opacity: 0.6;
    transition: all 0.2s ease;
    border-bottom: 3px solid transparent;
    display: flex;
    padding: 0;
    margin: 0;
}

/* Force removal of all borders on the image and the container link */
.img-trigger a, 
.img-trigger img {
    border: none !important;
    outline: none !important;
    display: block !important;
    box-shadow: none !important;
    background: none !important;
}

.img-trigger.active {
    opacity: 1;
    border-bottom: 3px solid #c8aa6e;
}

.img-tab-panel {
    display: none;
}

.img-tab-panel.active {
    display: block;
}

.item-grouped-container {
    font-family: inherit;
    width: 100%;
    overflow: visible !important;
}
.item-group-header {
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 4px;
    font-size: 1.2em;
    font-weight: bold;
}
.item-grid-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 15px;
    overflow: visible !important;
}

/* Strict 80x80 Item Card */
.item-card {
    display: inline-block;
    position: relative;
    width: 80px !important;
    height: 80px !important;
    border: 2px solid #1e2328;
    background-color: #000;
    cursor: pointer;
    isolation: isolate;
    overflow: visible !important;
    transition: transform 0.1s ease;
}

.item-card img,
.item-card a {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    position: relative;
    z-index: 2 !important;
}

.item-card:hover {
    border-color: #c8aa6e;
    transform: scale(1.1);
    z-index: 100;
}

/* --- ANIMATION KEYFRAMES --- */
@keyframes rotate {
   0% {
       transform: rotate(0deg) scale(0.75);
   }
   6.25% {
       transform: rotate(22.5deg) scale(0.6);
   }
   12.5% {
       transform: rotate(45deg) scale(0.8);
   }
   18.75% {
       transform: rotate(67.5deg) scale(0.6);
   }
   25% {
       transform: rotate(90deg) scale(0.8);
   }
   31.25% {
       transform: rotate(112.5deg) scale(0.6);
   }
   37.5% {
       transform: rotate(135deg) scale(0.7);
   }
   43.75% {
       transform: rotate(157.5deg) scale(0.6);
   }
   50% {
       transform: rotate(180deg) scale(0.75);
   }
   56.25% {
       transform: rotate(202.5deg) scale(0.6);
   }
   62.5% {
       transform: rotate(225deg) scale(0.7);
   }
   68.75% {
       transform: rotate(247.5deg) scale(0.6);
   }
   75% {
       transform: rotate(270deg) scale(0.85);
   }
   81.25% {
       transform: rotate(292.5deg) scale(0.6);
   }
   87.5% {
       transform: rotate(315deg) scale(0.7);
   }
   93.75% {
       transform: rotate(337.5deg) scale(0.6);
   }
   100% {
       transform: rotate(360deg) scale(0.8);
   }
}

