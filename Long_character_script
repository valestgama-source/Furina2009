	--warningbox-border: var(--errorbox-border);
	--successbox-bg: #2e5e05;
	--successbox-border: #3c780a;
	
	/* Recent changes */
	--rc-positive-color: #68C21E;
	--rc-negative-color: #F69288;
	
	/* diff */
	--diff-addedline-border-color: var(--rc-positive-color);
