/* --------------------
			 body
	 -------------------- */
body {
	font-family: "Arvo", serif;
}
	 
#mw-page-base {
	background: none;
}

.mw-body {
	background-color: var(--body-main);
	color: var(--text-color);
	border-color: transparent;
	/* box-shadow: 0 0 7px rgba(0, 0, 0, 0.15);  /* why such an insignificant shadow? */
	margin-top: 0;
	font-family: "Lato", sans-serif;
}

/* --------------------
		 headings
	 -------------------- */
h1,
h2,
h3,
h4,
h5,
h6,
.mw-heading {
	color: var(--text-color);
}

h1,
h2,
.mw-heading1,
.mw-heading2 {
	border-color: var(--lighter-grey);
}

/* -------------------------
	 <footer> below content
	 ------------------------- */
.mw-footer {
	color: var(--footer-text-color);
	text-shadow: 0px 2px 4px #000000b0;
}

.mw-footer li {
	color: var(--footer-text-color);
}

.mw-footer a,
.mw-footer a:active,
.mw-footer a:visited {
	color: var(--footer-link-color);
}

/* -------------------------
	 <input> placeholder
	 ------------------------- */
::placeholder {
	color: var(--subtle-color);
}

/* --------------------
		internal links
	 -------------------- */
a {
	color: var(--link-color);
}

 	
.mw-logevent-actionlink a,
.mw-logevent-tool a,
.mw-diff-tool a,
.mw-pager-tools a,
.mw-checkbox-toggle-controls a {
	/* !important so that it also applies to hover, active, etc */
	color: var(--link-color) !important;
}

a:visited,
a:active,
a:hover {
	color: var(--link-color);
}

a.new,
a.new:visited,
