    width: 577px; 
    
    /* ADJUST TOTAL HEIGHT HERE (Pixels) */
    height: 280px; 
    
    /* Updated border width to 2px for better visibility */
    border: 1px solid #ffc36b;
    box-sizing: border-box; 
    
    background: #010a13;
    box-shadow: 0 0 35px rgba(0,0,0,0.95);
    font-family: sans-serif;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
    display: flex;
}

#god-hover-card.visible { visibility: visible; opacity: 1; }

#god-hover-card.visible { visibility: visible; opacity: 1; }

.hcard-body { display: flex; width: 100%; height: 100%; }

/* PORTRAIT SIDE (Left) */
.hcard-art-side {
    width: 187px; /* Matches the 2:3 ratio of your 280px height */
    height: 100%;
    border-right: 1px solid #c8aa6e;
    flex-shrink: 0;
    background: #010a13; /* Match your card background */
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
}

.hcard-bg {
    width: 100%;
    height: 100%;
    background-size: cover; 
    background-position: center top; 
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
}

/* THE OVERLAY FRAME */
.hcard-frame {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5; 
    pointer-events: none;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-color: transparent !important;
}

.hcard-frame img, .hcard-bg img { display: none !important; }

/* CONTENT SIDE (Right) */
.hcard-text-side {
    flex-grow: 1;
    background: linear-gradient(135deg, #0a141e 0%, #010a13 100%);
    padding: 18px 25px 12px 20px; /* Adjusted padding */
    display: flex;
    flex-direction: column;
    position: relative;
    border-bottom: none;
    margin-left: 0;
}

/* DATA BLOCK (Top Right) */
.hcard-roles-stack {
    position: absolute;
    top: 18px; 
    right: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px; 
}

/* --- UPDATED ROLE CONTAINER LOGIC --- */
.hc-role-container {
    display: flex;
    align-items: center;
    gap: 0px; 
}

.hc-role-item {
    display: flex;
    align-items: center;
    gap: 5px; 
    color: #c8aa6e;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    margin: 0;
    padding: 0;
}

.hc-role-dot {
