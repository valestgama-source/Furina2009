/* =============================
           Syntax highlighting
   ============================== */
.mw-highlight {
  background: none;
}
.mw-highlight pre .hll {
  background-color: #49483e;
}
.mw-highlight pre .c {
  color: #949eaa;
}
/* Comment */
.mw-highlight pre .err {
  color: #960050;
}
/* Error */
.mw-highlight pre .k {
  color: #66d9ef;
}
/* Keyword */
.mw-highlight pre .l {
  color: #ae81ff;
}
/* Literal */
.mw-highlight pre .n {
  color: #f8f8f2;
}
/* Name */
.mw-highlight pre .o {
  color: #f92672;
}
/* Operator */
.mw-highlight pre .p {
  color: #f8f8f2;
}
/* Punctuation */
.mw-highlight pre .ch {
  color: #949eaa;
}
/* Comment.Hashbang */
.mw-highlight pre .cm {
  color: #949eaa;
}
