    position: relative;
    width: 80px !important;
    height: 80px !important;
    border: 2px solid #1e2328;
    background-color: #000;
    cursor: pointer;
    isolation: isolate;
    overflow: visible !important;
    transition: transform 0.1s ease;
}

.item-card img,
.item-card a {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    position: relative;
    z-index: 2 !important;
}

.item-card:hover {
    border-color: #c8aa6e;
    transform: scale(1.1);
    z-index: 100;
}

