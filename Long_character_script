       transform: rotate(112.5deg) scale(0.6);
   }
   37.5% {
       transform: rotate(135deg) scale(0.7);
   }
   43.75% {
       transform: rotate(157.5deg) scale(0.6);
   }
   50% {
       transform: rotate(180deg) scale(0.75);
   }
   56.25% {
       transform: rotate(202.5deg) scale(0.6);
   }
   62.5% {
       transform: rotate(225deg) scale(0.7);
