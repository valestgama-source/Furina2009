	/* Footer */
	--footer-text-color: var(--background-text-color);
	--footer-link-color: var(--background-link-color);
	
	/* Custom tooltips */
	--tooltip-background: #2B3B3E;
	
	/* 1.43 */
	--color-base: var(--text-color);
    --color-progressive: var(--link-color);
	--background-color-base: var(--body-main);
    --background-color-neutral-subtle: var(--body-main);
	--background-color-interactive: var(--body-mid);
