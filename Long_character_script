/* Template:Portal/News/Row */
.portal-news-updates-wrapper {
	text-align: left;
	display: grid;
	grid-template-columns: fit-content(400px) auto;
    grid-auto-rows: minmax(0, 150px);
	row-gap: 0.7rem;
}
.portal-news-row {
	overflow: hidden;
    display: grid;
    grid-template-columns: subgrid;
    grid-column-end: span 2;
    background: var(--portal-news-row-background-color);
    border: 1px solid var(--portal-news-border-color);
    position:relative;
    z-index:0;
}

.portal-news-image {
    overflow: hidden;
    border-left: 1px solid var(--portal-news-accent-color);
}
.portal-news-image img {
	width: 100%;
    height: 100%;
    object-fit: cover;
}
.portal-news-text {
    margin:0.3rem 1rem;
}
.portal-news-header__wrapper{
    position:relative;
    z-index: 0;
    display: flex;
    flex-flow: row nowrap;
    overflow:hidden;
    align-items:last baseline;
    white-space: nowrap;
    justify-content: space-between;
}
.portal-news-header{
    position:relative;
    z-index: 0;
    display:inline-block;
    border-bottom: 2px solid var(--portal-news-accent-color);
    font-weight: bold;
    padding-left: 1rem;
    padding-right: 0.3em;
    min-width: 3rem;
    margin-bottom: 15px;
    margin-right: 40px;
    margin-top: 0.3rem;
    font-size: 140%;
}
.portal-news-header::after{
    content:"";
    display:block;
    position:absolute;
    left: calc(100% - 17px);
    bottom: 0;
    width: 100%;
    height: 16px;
    border-left: 2px solid;
    border-bottom: 2px solid;
    border-color: var(--portal-news-accent-color);
    transform: rotate(-45deg);
    transform-origin: 19px bottom;
    box-sizing: border-box;
    
}
.portal-news-header::before{
    content:"";
    position:absolute;
    border-bottom: 1px solid #c99e42;
    left: calc(100% - 3px);
    right: -4000px;
    bottom:2px;
}
.portal-news-header-extra{
    position:absolute;
    top:0;
    left:0;
    right:0;
    bottom:0;
}
.portal-news-header-extra::before {
    content: "";
    border-bottom: 1px solid var(--portal-news-accent-color);
    position: absolute;
    left: 0;
    bottom: -6px;
    right: 11px;
}
.portal-news-header-extra::after {
    content: "";
    border-bottom: 1px solid var(--portal-news-accent-color);
    position: absolute;
    left: calc(100% - 11px);
    bottom: -6px;
    transform: rotate(-45deg);
    transform-origin: left bottom;
    width:12px;
}
.portal-news-subheader{
	color:var(--portal-news-subheader-color);
    font-size:90%;
    padding-right: 10px;
}
.portal-news-link{
	position:absolute;
	top:0;
	left:0;
	right:0;
	bottom:0;
	z-index:10;
}

.mw-parser-output .portal-news-row a.external {
	background: none;
	padding: 0;
}

