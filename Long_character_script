/* hlist */
.hlist dl,
.hlist ol,
.hlist ul {
	margin: 0;
	padding: 0;
}

/* Display list items inline */
.hlist dd,
.hlist dt,
.hlist li {
	margin: 0; /* don't trust the note that says margin doesn't work with inline
		* removing margin: 0 makes dds have margins again */
	display: inline;
}

/* Display nested lists inline */
.hlist.inline,
.hlist.inline dl,
.hlist.inline ol,
.hlist.inline ul,
.hlist dl dl,
.hlist dl ol,
.hlist dl ul,
.hlist ol dl,
.hlist ol ol,
.hlist ol ul,
.hlist ul dl,
.hlist ul ol,
.hlist ul ul {
	display: inline;
}

/* Hide empty list items */
.hlist .mw-empty-li {
	display: none;
}

/* Generate interpuncts */
.hlist dt:after {
	content: ": ";
}

.hlist dd:after {
	content: " · ";
	font-weight: bold;
}

.hlist dd:last-child:after,
.hlist dt:last-child:after,
.hlist li:last-child:after {
	content: none;
}

/* Add parentheses around nested lists */
.hlist dd dd:first-child:before,
.hlist dd dt:first-child:before,
.hlist dd li:first-child:before,
.hlist dt dd:first-child:before,
.hlist dt dt:first-child:before,
.hlist dt li:first-child:before,
.hlist li dd:first-child:before,
.hlist li dt:first-child:before,
.hlist li li:first-child:before {
	content: " (";
	font-weight: normal;
}

.hlist dd dd:last-child:after,
.hlist dd dt:last-child:after,
.hlist dd li:last-child:after,
.hlist dt dd:last-child:after,
.hlist dt dt:last-child:after,
.hlist dt li:last-child:after,
.hlist li dd:last-child:after,
.hlist li dt:last-child:after,
.hlist li li:last-child:after {
	content: ")";
	font-weight: normal;
}

/* Put ordinals in front of ordered list items */
.hlist ol {
	counter-reset: listitem;
}

.hlist ol > li {
	counter-increment: listitem;
}

.hlist ol > li:before {
	content: " " counter(listitem) "\a0";
}

.hlist dd ol > li:first-child:before,
.hlist dt ol > li:first-child:before,
.hlist li ol > li:first-child:before {
	content: " (" counter(listitem) "\a0";
}

/*******************
 * Infoboxes
 *******************/

.infobox-root {
	border-radius: 14px;
	clear: right;
	float: right;
	margin: 0 0 18px 18px;
	width: 270px;
	text-align: center;
	padding: 6px;
	background-color: var(--infobox-background);
	outline: 2px solid var(--infobox-outline-color);
	filter: drop-shadow(0px 3px 0px var(--infobox-shadow));
}

.infobox-title,.infobox-root .infobox-group,.infobox-root .infobox-group .infobox-header {
	border-radius: 10px
}

.infobox-root .infobox-title {
	font-family: m6x11,rubik;
	font-size: 36px;
	line-height: 1.25;
	padding: 9px 9px;
	font-weight: normal;
	background: var(--infobox-title-background);
	color: var(--infobox-title-color);
	text-shadow: 2px 2px black;
	filter: drop-shadow(0px 4px 0px var(--infobox-title-shadow));
	margin-bottom: 12px;
}

.infobox-root .infobox-group {
	margin-top: 8px;
	margin-bottom: 8px;
	padding-bottom: 8px;
	background-color: var(--infobox-group-background);
	color: var(--infobox-color);
	filter: drop-shadow(0px 4px 0px var(--infobox-group-shadow));
}

.infobox-root .infobox-group:last-of-type {
	margin-bottom: 3px;
}

.infobox-root .infobox-group .infobox-header {
	padding: 6px 6px 4px;
	background-color: inherit;
	color: inherit;
	align-content: center;
	font-family: 'm6x11';
	font-size: 22px;
	letter-spacing: 2px;
	word-wrap: break-word;
	line-height: 1;
	text-shadow: 1.5px 1.5px black;
}

.infobox-row-container {
	display: flex;
}

.infobox-row-container:has(> .infobox-row-label) {
	background: var(--infobox-outline-color);
	margin: 0 8px;
}

.infobox-row-container:has(> .infobox-row-label):last-of-type {
	border-bottom-left-radius: 10px;
	border-bottom-right-radius: 10px;
	padding-bottom: 8px;
	filter: drop-shadow(0px 3px 0px var(--infobox-shadow));
}

.infobox-group:not(:has(> .infobox-header)) > .infobox-row-container:has(> .infobox-row-label):nth-child(1),
.infobox-group:has(> .infobox-header) > .infobox-row-container:has(> .infobox-row-label):nth-of-type(2) {
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	padding-top: 8px;
}

.infobox-row-label {
	flex-basis: 175px;
	padding-left: 10px;
	align-content: center;
	font-family: 'm6x11';
	font-size: 15px;
