/* Recipe table stuff (WIP) */
.recipe-table > tbody > tr > td {
    width: 80px;
    vertical-align:top;
    white-space: nowrap;
}

.recipe-table .recipe-table {
    width: 100%;
}

.recipe-table tbody {
    text-align: center;
    display: inline-block;
}

.recipe-table tr {
    font-family: system-ui;
    color: #48c35c;
    text-shadow: 0 0 2px black;
    font-size: 16px;
    font-weight: 700;
    padding: 0;
    line-height: 1.5;
}

.recipe-table td a {
    position: relative;
    display: inline-block;
    border: 2px solid #65533c;
    outline: 2px solid #0000005c;
}

.recipe-table td a::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 17%);
    pointer-events: none;
    mask: linear-gradient(to top, transparent 0%, black 100%);
    -webkit-mask: linear-gradient(to top, transparent 0%, black 100%);
    margin: 1px;
    z-index: 2;
}

.recipe-vertical-line {
	border-right: 2px solid #484134;
}

.recipe-top-line {
	border-top: 2px solid #484134;
}

.recipe-arrow::after {
    content: "";
    display: block;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 10px solid #484134;
    position: absolute;
	translate: calc(-60% - 0.8px) -40%;
}

.glow-wrapper {
    transition: transform 0.1s ease;
}

tr:has(.glow-wrapper) {
    align-items: flex-start;
    justify-content: space-evenly;
    flex-direction: row;
    width: -webkit-fill-available;
    display: contents;
    flex-wrap: nowrap;
}

.glow-wrapper:hover {
    transform: scale(1.1);
}

.glow-wrapper:hover .mw-default-size::after, .glow-wrapper:hover .mw-default-size::before {
    content: '';
    position: absolute;
    top: -10px;
    right: -10px;
