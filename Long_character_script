  }
  62.5% {
      transform: rotate(-225deg) scale(0.8) scaleX(-1) scaleY(-1);
  }
  68.75% {
      transform: rotate(-247.5deg) scale(0.4) scaleX(-1) scaleY(-1);
  }
  75% {
