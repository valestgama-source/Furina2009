:root {
    --mw-code-background-color: #ddd4bb;
    --body-background-image: url('filepath://Old_School_RuneScape_Wiki_background.jpg');
}

#mw-page-base {
    background: none;
}

.mw-body {
    background-color: var(--body-main);
    color: var(--text-color);
    border-color: transparent;
    box-shadow: 0 0 7px rgba(0, 0, 0, 0.15);
    margin-top: 0;
}

.mw-heading,
h1,
h2,
h3,
h4,
h5,
h6 {
    color: var(--text-color);
}

.mw-heading1,
h1,
.mw-heading2,
h2 {
    border-color: var(--sidebar);
}

.mw-body h1,
.mw-body .mw-heading1,
.mw-body-content h1,
.mw-body-content .mw-heading1,
.mw-body-content h2,
.mw-body-content .mw-heading2,
.mw-body-content h3,
.mw-body-content .mw-heading3 {
    font-family: 'PT Serif', 'Palatino', 'Georgia', serif;
}

.mw-parser-output div:nth-child(1 of .mw-heading2) {
    clear: left;
}

.mw-footer {
    color: var(--background-text-color);
}

.mw-footer li {
    color: var(--background-text-color);
}

.mw-footer a,
.mw-footer a:active,
.mw-footer a:visited,
.mw-footer a:hover {
    color: var(--background-link-color);
}

::placeholder {
    color: var(--subtle-color);
}

.nowrap,
.nowraplinks a {
    white-space: nowrap;
}

.plainlist ol,
.plainlist ul {
    margin: 0;
    padding: 0;
}

.plainlist li {
    margin-bottom: 0;
    list-style: none;
}

.hlist {
}

.hlist ul {
    margin: 0;
    padding: 0;
}

.hlist li {
    display: inline;
}

.mw-parser-output .hlist li + li::before {
    content: ' • ';
    white-space: nowrap;
}

ul.hlist li,
.hlist > ul li {
    margin: 0;
}

.content .hlist ul ul {
    margin: 0;
    margin-inline: 0;
}

.hlist.inline,
.hlist.inline ul,
.hlist ul ul {
    display: inline;
}

.hlist li li:first-child::before {
    content: " (";
}

.hlist li li:last-child::after {
    content: ")";
}

