****************/
.card-hand {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: flex-end;
	margin: 0 4% 4% 8%;
	flex-wrap: nowrap;
	min-width: 20px;
}

.card-hand-card-image img {
	max-width: 100%;
	height: auto;
}

.card-hand-card {
	position: relative;
	max-width: none;
	transition: 0.2s ease;
	margin-left: -30px;
	display: flex;
	flex-direction: column;
	align-items: center;
}

.card-hand-card:hover {
	transform: translateY(-15%) scale(1.05) rotateY(0deg) !important;
	z-index: 1;		
}

.card-hand-card:active {
	transform: translateY(-20px) scale(1) !important;
	filter: drop-shadow(0px 10px 0px rgba(0, 0, 0, 0.5)) brightness(70%) !important;
}

.card-hand-card-image {
	transition: 0.3s ease;
	filter: drop-shadow(-4px 4px 0px rgba(0, 0, 0, 0.4));
}

.card-hand-card-image:hover {
	filter: drop-shadow(0px 8px 0px rgba(0, 0, 0, 0.5));
}

.card-hand-card:nth-child(1) { transform:rotate(-6deg) translate(0, 5%); }
.card-hand-card:nth-child(2) { transform:rotate(-3deg) translate(0, 1%); }
.card-hand-card:nth-child(3) { }
.card-hand-card:nth-child(4) { transform:rotate(3deg) translate(0, 1%); }
.card-hand-card:nth-child(5) { transform:rotate(6deg) translate(0, 5%); }

.card-hand-card-text {
	text-align: center;
	font-family: 'm6x11';
	line-height: 1;
	letter-spacing: 2px;
	color: white;
	padding: 6px 12px;
