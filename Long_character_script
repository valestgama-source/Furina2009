/** SMITE 2 Master CSS - Skin Viewer, Roster, & Hovercards **/

/* --- SKIN VIEWER --- */
.smite2-skin-viewer {
    width: 100%;
    max-width: 1067px;
    margin: 20px auto;
    background-color: #010a13;
    border: 1px solid #c8aa6e;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.skin-viewer-nav {
    display: flex;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.9);
    padding: 12px;
    gap: 12px;
    border-bottom: 1px solid #c8aa6e;
}

.skin-viewer-icon {
    width: 50px;
    height: 50px;
    cursor: pointer;
    border: 2px solid #1e2328;
    filter: grayscale(0.4);
    transition: all 0.2s ease;
    background-color: #000;
}

.skin-viewer-icon.active, 
.skin-viewer-icon:hover {
    border-color: #c8aa6e;
    filter: grayscale(0);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
}

.skin-viewer-icon img { 
    width: 100% !important; 
    height: 100% !important; 
    object-fit: cover; 
}

.skin-viewer-main {
    width: 100%;
    height: 600px;
    .skin-viewer-main {
    width: 100%;
    aspect-ratio: 16 / 9; /* <--- THIS LINE */
    max-height: 80vh;
    background-color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}
    background-color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.view-toggle-btn {
    position: absolute;
    top: 15px;
    right: 15px;
    z-index: 99;
    background: rgba(1, 10, 19, 0.85);
    border: 1px solid #c8aa6e;
    color: #f0e6d2;
    padding: 6px 14px;
    cursor: pointer;
    font-size: 0.8em;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: 0.2s;
    display: none;
}

.view-toggle-btn:hover { background: #c8aa6e; color: #010a13; }

.skin-viewer-active-image-wrap img { 
    width: 100% !important; 
    height: 100% !important; 
    object-fit: cover !important; /* <--- THIS LINE */
    object-position: center !important;
}

/* PRISM SYSTEM */
.skin-viewer-prism-container {
    position: absolute;
    bottom: 15px;
    left: 15px;
    display: flex;
    gap: 8px;
    z-index: 10;
}

.prism-swatch {
    width: 32px !important;
    height: 32px !important;
    border: 2px solid #1e2328;
    border-radius: 50%;
    cursor: pointer;
    transition: 0.2s;
    background-size: cover;
    background-position: center;
}

.prism-swatch.active, 
.prism-swatch:hover { 
    border-color: #c8aa6e; 
    transform: scale(1.1); 
}

/* INFO BAR */
.skin-viewer-info-bar { 
    background: #010a13; 
    border-top: 1px solid #c8aa6e; 
    padding: 15px 25px; 
    display: flex; 
    flex-direction: column; 
    gap: 8px; 
}

.skin-title-row { 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    width: 100%; 
    position: relative; 
}

.skin-name-group { 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
}

.skin-name-label { 
    color: #f0e6d2; 
    font-size: 1.6em; 
    font-weight: bold; 
    text-transform: uppercase; 
    letter-spacing: 2px; 
}

.skin-prism-subtitle { 
    color: #cdbe91; 
    font-size: 0.9em; 
    font-style: italic; 
    margin-top: -4px; 
}

.skin-purchase-row { 
    position: absolute; 
    right: 0; 
    display: flex; 
    gap: 20px; 
    align-items: center; 
}

.skin-rarity-badge, 
.skin-price-badge { 
    display: flex; 
    align-items: center; 
    gap: 8px; 
    color: #f0e6d2; 
    font-weight: bold; 
    font-size: 1.1em; 
}

.price-icon, 
.rarity-icon { 
    width: 22px; 
    height: 22px; 
    background-size: contain; 
    background-repeat: no-repeat; 
    background-position: center; 
    transition: 0.2s; 
}

