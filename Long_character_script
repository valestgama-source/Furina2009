.item-card .infobox,
.item-card .tooltip,
.item-card .tooltip-content {
    display: none !important;
}

/* --- SMITE STYLE ITEM HOVERCARD (JS POWERED) --- */
#item-hover-card {
    position: fixed;
    z-index: 10000;
    pointer-events: none;
    visibility: hidden;
    width: 320px;
    background: rgba(1, 10, 19, 0.95);
    border: 1px solid #c8aa6e;
    border-radius: 6px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.95);
    font-family: sans-serif;
    padding: 14px;
    box-sizing: border-box;
    opacity: 0;
    transition: opacity 0.15s ease-in-out;
}

#item-hover-card.visible {
    visibility: visible;
    opacity: 1;
}

#item-hover-card .skill-tooltip {
    margin: 0;
    padding: 0;
    color: #f0e6d2;
    font-size: 13px;
    line-height: 1.5;
    text-align: left;
}

/* Header layout containing the mini icon, item name, and price matching layout */
#item-hover-card .skill-tooltip-header {
    font-weight: bold;
    font-size: 15px;
    border-bottom: 1px solid rgba(200, 170, 110, 0.3);
    padding-bottom: 10px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #f0e6d2;
}

#item-hover-card .skill-tooltip-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
}

#item-hover-card .skill-tooltip-header img {
    width: 36px;
    height: 36px;
    border: 1px solid #c8aa6e;
    border-radius: 4px;
    object-fit: cover;
}

#item-hover-card .skill-tooltip-cost {
    color: #f8c456;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
}

#item-hover-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

#item-hover-card li {
    margin-bottom: 6px;
}

#item-hover-card .skill-tooltip-stats {
    color: #c8aa6e;
    font-weight: bold;
    margin-top: 6px;
    font-size: 13px;
}

#item-hover-card .skill-tooltip-statsdesc {
    color: #d1d5db;
}


@import "/load.php?mode=articles&articles=u:dev:MediaWiki:Grid.css&only=styles";
