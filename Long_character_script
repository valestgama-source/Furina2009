/* ==========================================================================
   HIGH-SPECIFICITY TOC NUMBERING FOR GLOBAL COMMON.CSS
   ========================================================================== */

/* Target elements explicitly under the body tag to increase cascading power */
body .toc, body .mw-toc, body #toc, body .sidebar-toc {
    counter-reset: toc-level-1 !important;
}

body .toc ul, body .toc ol, 
body .mw-toc ul, body .mw-toc ol, 
body .sidebar-toc-list ul, body .sidebar-toc-list ol {
    counter-reset: toc-level-2 !important;
}

body .toc ul ul, body .toc ol ol, 
body .mw-toc ul ul, body .mw-toc ol ol, 
body .sidebar-toc-list ul ul, body .sidebar-toc-list ol ol {
    counter-reset: toc-level-3 !important;
}

body .toc li, body .mw-toc li, body .sidebar-toc-item {
    list-style: none !important; 
}

/* Level 1: "1. " */
body .toc > ul > li > a::before, 
body .mw-toc > ul > li > a::before,
body .sidebar-toc-list > li > .sidebar-toc-link::before {
    counter-increment: toc-level-1 !important;
    content: counter(toc-level-1) ". " !important;
    font-weight: bold !important;
    margin-right: 0.5em !important;
}

/* Level 2: "1.1. " */
body .toc > ul > li > ul > li > a::before, 
body .mw-toc > ul > li > ul > li > a::before,
body .sidebar-toc-list > li > ul > li > .sidebar-toc-link::before {
    counter-increment: toc-level-2 !important;
    content: counter(toc-level-1) "." counter(toc-level-2) ". " !important;
    margin-right: 0.5em !important;
}

/* Level 3: "1.1.1. " */
body .toc > ul > li > ul > li > ul > li > a::before, 
body .mw-toc > ul > li > ul > li > ul > li > a::before,
body .sidebar-toc-list > li > ul > li > ul > li > .sidebar-toc-link::before {
    counter-increment: toc-level-3 !important;
    content: counter(toc-level-1) "." counter(toc-level-2) "." counter(toc-level-3) ". " !important;
    margin-right: 0.5em !important;
}

