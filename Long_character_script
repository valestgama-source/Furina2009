/* Tilting Infobox Image Styling */
.infobox-image-container {
	display: flex;
	justify-content: center;
	flex-direction: column;
	align-items: center;
}

.tilt-box-wrap {
	position: relative;
	transition: all 0.2s ease-out;
	width: 142px;
	height: 190px;
}

.tilt-box {
	width: 100%;
	height: 100%;
	position: relative;
	text-align: center;
	transition: all 0.2s ease-in-out;
}

.tilt_overlay {
	width: 20%;
	height: 20%;
	position: absolute;
	z-index: 1;
	overflow: hidden;
	opacity: 0;
}

/* Dimensions */
/* First row */
.tilt_overlay:nth-child(1) { left: 0; top: 0; }
.tilt_overlay:nth-child(2) { left: 20%; top: 0; }
.tilt_overlay:nth-child(3) { left: 40%; top: 0; }
.tilt_overlay:nth-child(4) { left: 60%; top: 0; }
.tilt_overlay:nth-child(5) { left: 80%; top: 0; }
/* Second row */
.tilt_overlay:nth-child(6) { left: 0; top: 20%; }
.tilt_overlay:nth-child(7) { left: 20%; top: 20%; }
.tilt_overlay:nth-child(8) { left: 40%; top: 20%; }
.tilt_overlay:nth-child(9) { left: 60%; top: 20%; }
.tilt_overlay:nth-child(10) { left: 80%; top: 20%; }
/* Third row	*/
.tilt_overlay:nth-child(11) { left: 0; top: 40%; }
.tilt_overlay:nth-child(12) { left: 20%; top: 40%; }
.tilt_overlay:nth-child(13) { left: 40%; top: 40%; }
.tilt_overlay:nth-child(14) { left: 60%; top: 40%; }
.tilt_overlay:nth-child(15) { left: 80%; top: 40%; }
/* Fourth row */
.tilt_overlay:nth-child(16) { left: 0; top: 60%; }
.tilt_overlay:nth-child(17) { left: 20%; top: 60%; }
.tilt_overlay:nth-child(18) { left: 40%; top: 60%; }
.tilt_overlay:nth-child(19) { left: 60%; top: 60%; }
.tilt_overlay:nth-child(20) { left: 80%; top: 60%; }
/* Fifth row */
.tilt_overlay:nth-child(21) { left: 0; top: 80%; }
.tilt_overlay:nth-child(22) { left: 20%; top: 80%; }
.tilt_overlay:nth-child(23) { left: 40%; top: 80%; }
.tilt_overlay:nth-child(24) { left: 60%; top: 80%; }
.tilt_overlay:nth-child(25) { left: 80%; top: 80%; }

/* First row	*/
.tilt_overlay:nth-child(1):hover ~ .tilt-box { 
	transform: rotateX(20deg) rotateY(-20deg); 
	filter: drop-shadow(20px 20px 0px rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(2):hover ~ .tilt-box { 
	transform: rotateX(20deg) rotateY(-10deg);
	filter: drop-shadow(10px 20px 0px rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(3):hover ~ .tilt-box { 
	transform: rotateX(20deg) rotateY(0deg);
	filter: drop-shadow(0px 20px 0px rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(4):hover ~ .tilt-box { 
	transform: rotateX(20deg) rotateY(10deg);
	filter: drop-shadow(-10px 20px 0px rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(5):hover ~ .tilt-box { 
	transform: rotateX(20deg) rotateY(20deg);
	filter: drop-shadow(-20px 20px 0px rgba(0,0,0,0.4));}

/* Second row */
.tilt_overlay:nth-child(6):hover ~ .tilt-box { 
	transform: rotateX(10deg) rotateY(-20deg);
	filter: drop-shadow(20px 10px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(7):hover ~ .tilt-box { 
	transform: rotateX(10deg) rotateY(-10deg);
	filter: drop-shadow(10px 10px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(8):hover ~ .tilt-box { 
	transform: rotateX(10deg) rotateY(0deg);
	filter: drop-shadow(0px 10px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(9):hover ~ .tilt-box { 
	transform: rotateX(10deg) rotateY(10deg);
	filter: drop-shadow(-10px 10px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(10):hover ~ .tilt-box { 
	transform: rotateX(10deg) rotateY(20deg);
	filter: drop-shadow(-20px 10px 0 rgba(0,0,0,0.4));}

/* Third row */
.tilt_overlay:nth-child(11):hover ~ .tilt-box { 
	transform: rotateX(0deg) rotateY(-20deg);
	filter: drop-shadow(20px 0px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(12):hover ~ .tilt-box { 
	transform: rotateX(0deg) rotateY(-10deg);
	filter: drop-shadow(10px 0px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(13):hover ~ .tilt-box { 
	transform: rotateX(0deg) rotateY(0deg);
	filter: drop-shadow(0 20px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(14):hover ~ .tilt-box { 
	transform: rotateX(0deg) rotateY(10deg);
	filter: drop-shadow(-10px 0px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(15):hover ~ .tilt-box { 
	transform: rotateX(0deg) rotateY(20deg);
	filter: drop-shadow(-20px 0px 0 rgba(0,0,0,0.4));}

/* Fourth row */
.tilt_overlay:nth-child(16):hover ~ .tilt-box { 
	transform: rotateX(-10deg) rotateY(-20deg);
	filter: drop-shadow(20px -10px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(17):hover ~ .tilt-box { 
	transform: rotateX(-10deg) rotateY(-10deg);
	filter: drop-shadow(10px -10px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(18):hover ~ .tilt-box { 
	transform: rotateX(-10deg) rotateY(0deg);
	filter: drop-shadow(0px -10px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(19):hover ~ .tilt-box { 
	transform: rotateX(-10deg) rotateY(10deg);
	filter: drop-shadow(-10px -10px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(20):hover ~ .tilt-box { 
	transform: rotateX(-10deg) rotateY(20deg);
	filter: drop-shadow(-20px -10px 0 rgba(0,0,0,0.4));}

/* Fifth row */
.tilt_overlay:nth-child(21):hover ~ .tilt-box { 
	transform: rotateX(-20deg) rotateY(-20deg);
	filter: drop-shadow(20px -20px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(22):hover ~ .tilt-box { 
	transform: rotateX(-20deg) rotateY(-10deg);
	filter: drop-shadow(10px -20px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(23):hover ~ .tilt-box { 
	transform: rotateX(-20deg) rotateY(0deg);
	filter: drop-shadow(0px -20px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(24):hover ~ .tilt-box { 
	transform: rotateX(-20deg) rotateY(10deg);
	filter: drop-shadow(-10px -20px 0 rgba(0,0,0,0.4));}
.tilt_overlay:nth-child(25):hover ~ .tilt-box { 
	transform: rotateX(-20deg) rotateY(20deg);
	filter: drop-shadow(-20px -20px 0 rgba(0,0,0,0.4));}
	
/* End of Tilting Infobox Image Styling */

