.gm-grid-wrapper .gm-grid .gm-item {
    display: flex;
    padding: 2px;
    align-items: center;
    flex-direction: column;
    cursor: pointer;
}

.gm-grid-wrapper .gm-grid .gm-item.gm-item-active {
    position: relative;
}

.gm-grid-wrapper .gm-grid .gm-item.gm-item-active::before {
