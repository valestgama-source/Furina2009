/* §50 PARCHE VISUALEDITOR — Aislamiento y corrección de borrado VE */
/* Este bloque previene que las reglas de la wiki afecten al DOM interno del editor,
   lo cual causa el desfase de selección y el bug de borrado. */

/* 1. Resetear propiedades críticas en el editor para que el navegador y VE se sincronicen */
.ve-ce-surface, .ve-ce-surface *,
.ve-ui-surface, .ve-ui-surface *,
.ve-init-mw-desktopArticleTarget, .ve-init-mw-desktopArticleTarget * {
    user-select: auto !important;
    -webkit-user-select: auto !important;
    pointer-events: auto !important;
    text-shadow: none !important;
    text-indent: 0 !important;
}

/* 2. Restaurar la selección nativa dentro del editor (el navegador necesita ver esto para calcular offsets) */
.ve-ce-surface ::selection,
.ve-ce-surface *::selection,
.ve-ui-surface ::selection,
.ve-ui-surface *::selection {
    background: rgba(109, 169, 247, 0.5) !important;
    color: inherit !important;
    -webkit-text-fill-color: inherit !important;
    text-shadow: none !important;
}

/* 3. Prevenir que la animación de enlaces de la wiki rompa los enlaces dentro de VE */
.ve-ce-surface a:not(.new):not(.external) {
    background-image: none !important;
    background-size: auto !important;
    transition: none !important;
}

/* 4. Prevenir que las reglas de display/visibility forzadas afecten a los elementos ocultos de VE (como nails) */
.ve-ce-surface [style*="display: none"],
.ve-ce-surface [style*="display:none"],
.ve-ce-surface [hidden],
.ve-ce-surface [style*="visibility"] {
    visibility: inherit !important;
    opacity: inherit !important;
    display: inherit !important;
}

/* 5. Excluir al editor del modo oscuro forzado (VE maneja sus propios colores) */
html:has(body[data-theme="dark"]) .ve-ce-surface [style],
body[data-theme="dark"] .ve-ce-surface [style],
html:has(body[data-theme="dark"]) .ve-ui-surface [style],
body[data-theme="dark"] .ve-ui-surface [style] {
    background-color: inherit !important;
    color: inherit !important;
    border-color: inherit !important;
}

/* 6. Asegurar que los botones e inputs del editor no hereden los estilos de la wiki */
.ve-ce-surface button,
.ve-ce-surface input,
.ve-ce-surface textarea,
.ve-ce-surface select,
.ve-ui-surface button,
.ve-ui-surface input,
.ve-ui-surface textarea,
.ve-ui-surface select {
    font-family: inherit !important;
    box-shadow: none !important;
}

/* 7. Forzar que las tablas e imágenes dentro del editor mantengan su layout nativo */
.ve-ce-surface img,
.ve-ce-surface video,
.ve-ce-surface table,
.ve-ce-surface pre {
    max-width: none !important;
    display: inherit !important;
}

/* §51 PARCHE WIKIMEDIA — Sincronización de capas */
/* Asegura que el editor siempre esté en la capa superior sin interferir con el layout de la página */
.ve-ce-surface {
    z-index: 1 !important;
}
.ve-ui-surface {
    z-index: 2 !important;
}
.ve-ce-surface-clipboardHandler {
    z-index: 3 !important;
}

