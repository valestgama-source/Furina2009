@keyframes rotate {
   0% {
       transform: rotate(0deg) scale(0.75);
   }
   6.25% {
       transform: rotate(22.5deg) scale(0.6);
   }
   12.5% {
       transform: rotate(45deg) scale(0.8);
   }
   18.75% {
       transform: rotate(67.5deg) scale(0.6);
   }
   25% {
