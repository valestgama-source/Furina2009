/** Main page **/
body.page-Smite_2_Wiki .firstHeading {
	display: none;
}

.mainpage-row {
	display: flex;
	gap: 1em;
	flex-wrap: wrap;
}

.mainpage-col:first-child {
	flex-basis: 60%;
	flex-grow: 1;
}

.mainpage-col:last-child {
	flex-basis: 30%;
	flex-grow: 1;
}

@media screen and (max-width: 1200px) {
	.mainpage-col {
		flex-basis: 100% !important;
	}
}

.mainpage-intro {
	display: flex;
	align-items: center;
}

.mainpage-header {
    font-family: system-ui;
    font-weight: bold;
    font-size: 22px;
    text-transform: uppercase;
    color: #FAC76A;
    overflow: hidden;
}

.mainpage-header::before,
.mainpage-header::after {
    content: '';
    display: inline-block;
    width: 20%;
    height: 11px;
    background: var(--link-color);
    clip-path: polygon(5px 0px, 5px 0px, 9px 4px, 90% 5px, 9px 6px, 5px 10px, 0px 5px);
    margin: 2px 10px;
    max-width: 140px;
}

.mainpage-header::before {
    rotate: 180deg;
}

.mainpage-section {
	text-align: center;
}

.mainpage-game-platforms,
.mainpage-socials {
	display: flex;
	justify-content: center;
	gap: 2px;
	margin: 0.5em;
}

.mainpage-socials {
	padding: 0.5em 0;
}

.mainpage-game-platform {
    width: 64px;
    height: 64px;
    border-radius: 6px;
    display: flex;
    justify-content: center;
	align-items: center;
}

.mainpage-game-platform > span {
    filter:invert(100%);
}

.mainpage-social-link {
    width: 30px;
    height: 30px;
    background-color: #2E3139;
    display: flex;
    justify-content: center;
	align-items: center;
}

.mainpage-social-link > span {
    filter:invert(100%);
}

