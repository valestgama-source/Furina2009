/* --- ROSTER CONTROLS --- */
.roster-controls-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 25px;
    justify-content: center;
    align-items: center;
    background: rgba(1, 10, 19, 0.9);
    padding: 15px;
    border: 1px solid #c8aa6e;
    border-radius: 2px;
}

#godSearch, 
.god-drop {
    background: #010a13;
    color: #f0e6d2;
    border: 1px solid #5b4a2d;
    padding: 8px 12px;
    font-size: 14px;
    transition: all 0.2s ease;
    min-width: 150px;
}

#godSearch:focus, 
.god-drop:hover, 
.god-drop:focus {
    border-color: #c8aa6e;
    outline: none;
    background: #0a141e;
}

#godSearch { flex-grow: 1; max-width: 250px; }

/* --- THE GRID --- */
.roster-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    padding: 20px;
    background: #010a13;
    border: 1px solid #c8aa6e;
    box-shadow: inset 0 0 30px rgba(0,0,0,0.8);
}

.roster-item {
    position: relative;
    width: 80px !important;
    height: 80px !important;
    border: 2px solid #1e2328;
    background-color: #000;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    isolation: isolate; /* Safely contains the pseudo-layers without breaking layout */
}

.roster-item a,  
.roster-item img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    position: relative;
    z-index: 2;
}

.roster-item.filtered {
    filter: grayscale(1) brightness(0.15);
    opacity: 0.15;
    pointer-events: none;
    transform: scale(0.85);
    border-color: #000;
}

.roster-item:hover {
    border-color: #c8aa6e;
    transform: translateY(-5px);
    z-index: 100;
    box-shadow: 0 10px 25px rgba(0,0,0,1);
}

/* Glimmering Glow Animation Layers for Roster Items */
.roster-item:hover::before,
.roster-item:hover::after {
    content: '';
    position: absolute;
    top: -10px;
    right: -10px;
