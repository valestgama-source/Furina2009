/* §1 VARIABLES LIGHT */
:root,:root[class*="theme"],:root[class*="odyssey"],/* 
   Engine-Common.css
   Author: Wkizks (Player2D)
*/

:root {
    /* Colores - Wikipedia Light */
    --wp-bg: #ffffff;
    --wp-bg-alt: #f8f9fa;
    --wp-bg-alt-2: #eaecf0;
    --wp-text: #202122;
    --wp-text-mute: #54595d;
    --wp-text-dim: #72777d;
    --wp-title-color: #000000;
    --wp-link: #3366cc;
    --wp-link-hover: #447ff5;
    --wp-link-visited: #795cb2;
    --wp-link-red: #d33;
    --wp-border: #a2a9b1;
    --wp-border-soft: #c8ccd1;
    --wp-border-mute: #eaecf0;
    --wp-hover-bg: #eaf3ff;
    --wp-code-bg: #f8f9fa;
    --wp-code-border: #eaecf0;
    --wp-select-bg: #b3d4ff;
    --wp-select-text: #000000;

    /* Estados (adaptados de TF-Engine) */
    --wp-success: #14866d;
    --wp-success-bg: rgba(20, 134, 109, .10);
    --wp-warning: #d4a017;
    --wp-warning-bg: rgba(212, 160, 23, .10);
    --wp-error: #b81c1c;
    --wp-error-bg: rgba(184, 28, 28, .10);
    --wp-info: #056d9e;
    --wp-info-bg: rgba(5, 109, 158, .10);

    /* Tipografía */
    --wp-body-font: sans-serif;
    --wp-head-font: 'Linux Libertine', 'Georgia', 'Times', serif;
    --wp-code-font: monospace, monospace;
    --wp-content-max: 1650px;
    --wp-line-height: 1.6;

    /* Tokens de layout (heredados de TF-Engine) */
    --tf-container-width: 1200px;
    --tf-content-gap: 16px;
    --tf-grid-min: 240px;
    --tf-navbar-height: 50px;

    /* Spacing (TF-Engine) */
    --tf-space-2xs: 2px;
    --tf-space-xs: 4px;
    --tf-space-sm: 8px;
    --tf-space-md: 16px;
    --tf-space-lg: 24px;
    --tf-space-xl: 32px;
    --tf-space-2xl: 48px;

    /* Aliases cortos (compatibilidad con código TF-Engine existente) */
    --xxs: 2px;
    --xs: 4px;
    --sm: 8px;
    --md: 16px;
    --lg: 24px;
    --xl: 32px;
    --xxl: 48px;
    --pd: 20px 25px;
    --pd-card: 16px;
    --gp: 8px;
    --mg: 16px;

    /* Radii (TF-Engine) */
    --rd: 8px;
    --rd-sm: 4px;
    --rd-lg: 14px;
    --rd-pill: 999px;
    --rd-xs: 2px;
    --tf-card-radius: var(--rd);
    --tf-btn-radius: var(--rd);
    --tf-badge-radius: var(--rd-pill);
    --tf-tag-radius: var(--rd-sm);

    /* Shadows (TF-Engine, sutiles para Wikipedia) */
    --ss: 0 2px 8px rgba(0, 0, 0, .06);
    --sh: 0 4px 14px rgba(0, 0, 0, .10);
    --is: inset 0 1px 2px rgba(0, 0, 0, .06);
    --gl: 0 0 10px rgba(51, 102, 204, .25);
    --e1: 0 1px 3px rgba(0, 0, 0, .08);
    --e2: 0 4px 10px rgba(0, 0, 0, .10);
    --e3: 0 10px 25px rgba(0, 0, 0, .12);
    --tf-shadow-sm: var(--ss);
    --tf-shadow-md: var(--sh);
    --tf-shadow-lg: var(--e3);

    /* Motion (TF-Engine) */
    --tr-fast: .15s;
    --tr-normal: .3s;
    --tr-tab: .35s;
    --ease: cubic-bezier(.4, 0, .2, 1);
    --ease-out: cubic-bezier(.16, 1, .3, 1);
    --tf-transition: .2s ease;
    --tf-transition-fast: .15s ease;
    --tf-transition-slow: .3s ease;

    /* Z-Index */
    --tf-z-dropdown: 100;
    --tf-z-sticky: 200;
    --tf-z-modal: 1000;
    --tf-z-tooltip: 2000;

    /* Focus */
    --tf-focus-outline: 2px solid var(--wp-link);
    --tf-focus-offset: 2px;

    /* Theme overrides (Fandom tokens) */
    --theme-body-background-color: #ffffff !important;
    --theme-page-background-color: #ffffff !important;
    --theme-page-background-color--secondary: #f8f9fa !important;
    --theme-body-text-color: #202122 !important;
    --theme-page-text-color: #202122 !important;
    --theme-link-color: #3366cc !important;
    --theme-link-color--rgb: 51, 102, 204 !important;
    --theme-link-label-color: #3366cc !important;
    --theme-accent-color: #3366cc !important;
    --theme-border-color: #a2a9b1 !important;
    --theme-page-headings-font: 'Linux Libertine', 'Georgia', 'Times', serif !important;

    color-scheme: light !important;
    accent-color: #3366cc !important;
    caret-color: #202122;
}

html:has(body[data-theme="dark"]),
html:has(body.theme-fandomdesktop-dark),
html:has(body[class*="theme-fandomdesktop-dark"]),
html[data-theme="dark"],
html[class*="theme-fandomdesktop-dark"],
body[data-theme="dark"],
body.theme-fandomdesktop-dark,
body[class*="theme-fandomdesktop-dark"] {
    --wp-bg: #101418;
    --wp-bg-alt: #1a2330;
    --wp-bg-alt-2: #27292d;
    --wp-text: #eaecf0;
    --wp-text-mute: #a2a9b1;
    --wp-text-dim: #b8bfc7;
    --wp-title-color: #eaecf0;
    --wp-link: #8cb4ff;
    --wp-link-hover: #a8c8ff;
    --wp-link-visited: #b39dff;
    --wp-link-red: #ff8080;
    --wp-border: #54595d;
    --wp-border-soft: #3a4a5a;
    --wp-border-mute: #2a3a4a;
    --wp-hover-bg: #1f3a5f;
    --wp-code-bg: #1a2330;
    --wp-code-border: #2a3a4a;
    --wp-select-bg: #2a5a9e;
    --wp-select-text: #ffffff;

    --wp-success: #4ade80;
    --wp-success-bg: rgba(74, 222, 128, .10);
    --wp-warning: #f0c45a;
    --wp-warning-bg: rgba(240, 196, 90, .10);
    --wp-error: #ff8080;
    --wp-error-bg: rgba(255, 128, 128, .10);
    --wp-info: #8ddaff;
    --wp-info-bg: rgba(141, 218, 255, .10);

    --ss: 0 2px 8px rgba(0, 0, 0, .35);
    --sh: 0 4px 14px rgba(0, 0, 0, .50);
    --gl: 0 0 10px rgba(140, 180, 255, .30);

    --theme-body-background-color: #101418 !important;
    --theme-page-background-color: #101418 !important;
    --theme-page-background-color--secondary: #1a2330 !important;
    --theme-body-text-color: #eaecf0 !important;
    --theme-page-text-color: #eaecf0 !important;
    --theme-link-color: #8cb4ff !important;
    --theme-link-color--rgb: 140, 180, 255 !important;
    --theme-link-label-color: #8cb4ff !important;
    --theme-accent-color: #8cb4ff !important;
    --theme-border-color: #54595d !important;

    color-scheme: dark !important;
    accent-color: #8cb4ff !important;
    caret-color: #eaecf0;
}

html,
body {
    background: var(--wp-bg) !important;
    background-color: var(--wp-bg) !important;
    background-image: none !important;
    color: var(--wp-text) !important;
    font-family: var(--wp-body-font) !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
}

/* Elimina pseudo-elementos decorativos residuales (selector fusionado) */
:is(html, body, .page, .page__main, .main-container)::before,
:is(html, body, .page, .page__main, .main-container)::after {
    content: none !important;
    display: none !important;
}

/* === TABBER (fusionado + animación mejorada, sin JS) === */
.tabber :is(.wds-tabs__tab-label, .wds-tabs__tab)::before,
.tabber :is(.wds-tabs__tab-label, .wds-tabs__tab)::after,
.tabber ul.wds-tabs li::marker,
.tabber ul.wds-tabs li::before,
.tabber ul.wds-tabs li::after {
    display: none !important;
    content: none !important;
}

.tabber ul.wds-tabs,
.tabber ul.wds-tabs li {
    list-style: none !important;
    list-style-type: none !important;
    list-style-image: none !important;
}

.tabber .wds-tabs {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 2px !important;
    border-bottom: 1px solid var(--wp-border-soft) !important;
    padding: 0 !important;
    margin: 0 0 14px 0 !important;
}

.tabber .wds-tabs__tab {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* El link es el contenedor posicional del indicador animado */
.tabber .wds-tabs__tab-label a,
.tabber .wds-tabs__tab a {
    position: relative !important;
    display: inline-block !important;
    padding: 6px 12px !important;
    color: var(--wp-link) !important;
    border-bottom: 2px solid transparent !important;
    text-decoration: none !important;
    font-size: 13px !important;
    transition: color var(--tr-fast) var(--ease) !important;
    overflow: visible !important;
}

/* Barra inferior: crece desde el centro en hover/focus, pura CSS */
.tabber .wds-tabs__tab-label a::after,
.tabber .wds-tabs__tab a::after {
    content: "" !important;
    position: absolute !important;
    left: 8% !important;
    right: 8% !important;
    bottom: -1px !important;
    height: 2px !important;
    border-radius: var(--rd-pill) !important;
    background: var(--wp-link-hover) !important;
    transform: scaleX(0) !important;
    transform-origin: center !important;
    opacity: 0 !important;
    transition: transform var(--tr-tab) var(--ease-out),
                opacity var(--tr-fast) var(--ease) !important;
    pointer-events: none !important;
}

.tabber .wds-tabs__tab-label a:hover::after,
.tabber .wds-tabs__tab a:hover::after,
.tabber .wds-tabs__tab-label a:focus-visible::after,
.tabber .wds-tabs__tab a:focus-visible::after {
    transform: scaleX(1) !important;
    opacity: 1 !important;
}

.tabber .wds-tabs__tab-label a:hover,
.tabber .wds-tabs__tab a:hover {
    color: var(--wp-link-hover) !important;
    border-bottom-color: transparent !important;
}

/* Pestaña activa: barra fija al 100%, sin opacidad, con glow sutil al entrar */
.tabber .wds-tabs__tab.wds-is-current .wds-tabs__tab-label a,
.tabber .wds-tabs__tab.wds-is-current a {
    color: var(--wp-title-color) !important;
    border-bottom-color: transparent !important;
    font-weight: bold !important;
    animation: tf-tab-activate var(--tr-tab) var(--ease-out) !important;
}

.tabber .wds-tabs__tab.wds-is-current .wds-tabs__tab-label a::after,
.tabber .wds-tabs__tab.wds-is-current a::after {
    left: 0 !important;
    right: 0 !important;
    height: 2.5px !important;
    background: var(--wp-link) !important;
    box-shadow: var(--gl) !important;
    transform: scaleX(1) !important;
    opacity: 1 !important;
}

@keyframes tf-tab-activate {
    from { color: var(--wp-link); }
    to { color: var(--wp-title-color); }
}

/* Contenido del panel: fade + slide sutil al mostrarse (CSS puro) */
.tabber .tabbertab {
    padding: 6px 0 !important;
    animation: tf-tab-panel-in var(--tr-normal) var(--ease-out) !important;
}

@keyframes tf-tab-panel-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
    .tabber .wds-tabs__tab-label a::after,
    .tabber .wds-tabs__tab a::after,
    .tabber .wds-tabs__tab.wds-is-current a,
    .tabber .tabbertab {
        animation: none !important;
        transition: none !important;
    }
}
