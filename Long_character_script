/********************/
/* Infoboxes        */
/********************/

.infobox {
	box-sizing: border-box;
	background: var(--infobox-background);
	border: 1px solid var(--infobox-border);
    font-size: 0.85em;
    word-break: break-word;
    margin-bottom: 2em;
    position: relative;
    z-index: 0;
}
.infobox-title {
	font-size: 18px;
    padding: 0.4em;
}
.infobox-header {
	padding: 0.3em;
}
.infobox-title,
.infobox-header {
	text-align: center;
	background: var(--infobox-accent);
	font-weight: 700;
    line-height: 1.5;
    font-size: 1.15em;
    line-height: 1.4em;
}

.infobox-image,
.infobox-gallery {
	text-align: center;
}
.infobox-gallery img,
.infobox-image img {
	height: auto;
	max-width: 100%;
}

.infobox-section .infobox-data-row,
.infobox-section-column .infobox-data-row,
.infobox-section-stacked .infobox-data-row {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-style: solid;
    border-top-width: 1px;
    border-color: var(--infobox-accent);
}

.infobox-section-column {
	display:grid;
	grid-template-columns: 2fr 3fr;
}
.infobox-section-column .infobox-data-row {
	display: grid;
	grid-column: 1 / -1;
	grid-template-columns: subgrid;
}
.infobox-section-stacked .infobox-data-value {
	margin-left: 1.2em;
}

.infobox-data-label {
	font-size: 14px;
    font-weight: 700;
}

.infobox-section-cell {
	display: flex;
	text-align: center;
	justify-items: stretch;
    flex-wrap: wrap;
}
.infobox-section-cell > * {
	flex: 1 0 30%;
}


.infobox-section-cell-row {
	display: flex;
	flex-flow: row wrap;
	text-align: center;
	justify-items: stretch;
}
.infobox-section-cell-row > * {
	flex: 1 1 0;
}

.infobox-section-two-cell {
	display:grid;
	grid-template-columns: repeat(2, 1fr);
	text-align:center;
}
.infobox-section-two-cell .infobox-data-row:nth-child(2n+1) {
	border-right: 1px solid var(--infobox-border);  /* todo redo border */
}
.infobox-section-two-cell .infobox-data-row {
	border-bottom: 1px solid var(--infobox-border); /* todo redo border */
}

.infobox-section-three-cell {
	display:grid;
	grid-template-columns: repeat(3, 1fr);
	text-align:center;
}

.infobox-section-cell .infobox-data-row,
.infobox-section-two-cell .infobox-data-row,
.infobox-section-three-cell .infobox-data-row {
	/*padding-top: 4px;
	padding-bottom: 4px;*/
	padding: 4px;
}

